# Shared secret between the API server and this service
AI_SERVICE_TOKEN=dev-service-token

# Where the Express API is reachable (used to fetch user context)
SERVER_URL=http://localhost:4000

# OpenAI-compatible API. Leave the key empty to run in offline fallback mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
